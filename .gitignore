# Local-only v1 editor + launcher — never published to the website.
# Anchored to root (/) so they do NOT also ignore the committed v2 editor/editor.html.
/editor.html
/editor.html.bak-*
/run-editor.command

# Editor v2 (TipTap) is committed to this repo — but NOT its deps or the big source map
editor/node_modules/
editor/vendor/*.map
__pycache__/
.claude-fix-fragment.html

# Private drafts — tracked in a SEPARATE private repo, never on the public site
drafts/

# Secrets — never publish to the website
.env
.env.*
*.key

# OS
.DS_Store
**/.DS_Store
